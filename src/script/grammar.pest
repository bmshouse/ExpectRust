// Expect/Tcl Grammar for Pest Parser

WHITESPACE = _{ " " | "\t" | "\r" }
COMMENT = _{ "#" ~ (!"\n" ~ ANY)* }

// Entry point
script = { SOI ~ statement* ~ EOI }

// Statements
statement = {
    spawn_stmt
  | expect_stmt
  | send_stmt
  | set_stmt
  | if_stmt
  | while_stmt
  | for_stmt
  | proc_stmt
  | close_stmt
  | wait_stmt
  | interact_stmt
  | exp_continue_stmt
  | exit_stmt
  | call_stmt
  | newline
}

spawn_stmt = { "spawn" ~ word+ ~ stmt_end }

expect_stmt = { "expect" ~ (expect_block | pattern_spec) ~ stmt_end }

expect_block = { "{" ~ newline* ~ (expect_case ~ newline*)+ ~ "}" }

expect_case = { pattern_spec ~ brace_block }

pattern_spec = {
    ("-re" ~ word)
  | ("-gl" ~ word)
  | "timeout"
  | "eof"
  | word
}

send_stmt = { "send" ~ word ~ stmt_end }

// The assigned value is either a plain word (existing behavior: numbers,
// strings, and bare "$var" text resolved via runtime text-substitution) or
// a parenthesized computed expression like `($i + 1)` - needed for anything
// that increments a loop counter (`while`/`for` would otherwise have a
// working condition but no way to actually change the loop variable).
set_stmt = { "set" ~ identifier ~ (paren_expr | word) ~ stmt_end }

paren_expr = { "(" ~ expression ~ ")" }

if_stmt = {
    "if" ~ condition ~ brace_block ~ ("else" ~ brace_block)? ~ stmt_end
}

while_stmt = { "while" ~ condition ~ brace_block ~ stmt_end }

for_stmt = {
    "for" ~ brace_block ~ condition ~ brace_block ~ brace_block ~ stmt_end
}

// A boolean condition: `{ <expression> }`, e.g. `{ $x == 1 }`. Distinct from
// `brace_block` (a sequence of statements) - if/while/for's condition slot
// is an expression to evaluate, not statements to run.
condition = { "{" ~ expression ~ "}" }

proc_stmt = {
    "proc" ~ identifier ~ brace_list ~ brace_block ~ stmt_end
}

call_stmt = { identifier ~ word* ~ stmt_end }

close_stmt = { "close" ~ stmt_end }

wait_stmt = { "wait" ~ stmt_end }

interact_stmt = { "interact" ~ stmt_end }

exp_continue_stmt = { "exp_continue" ~ stmt_end }

exit_stmt = { "exit" ~ word? ~ stmt_end }

// Blocks
brace_block = { "{" ~ newline* ~ statement* ~ "}" }

brace_list = { "{" ~ identifier* ~ "}" }

// Expressions
expression = {
    binary_expr
  | unary_expr
  | primary_expr
}

binary_expr = {
    primary_expr ~ binary_op ~ expression
}

unary_expr = {
    unary_op ~ primary_expr
}

primary_expr = {
    number
  | variable
  | string
  | brace_string
  | list
  | bare_word
}

// Word can be any primary expression or a bare word
word = {
    number
  | variable
  | string
  | brace_string
  | list
  | bare_word
}

bare_word = @{
    (ASCII_ALPHANUMERIC | "_" | "-" | "." | "/" | "\\")+
}

binary_op = {
    "+"  | "-"  | "*"  | "/"
  | "==" | "!=" | "<=" | ">=" | "<" | ">"
  | "&&" | "||"
}

unary_op = {
    "-" | "!"
}

// Primitives
number = @{
    "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)?
}

// `$name` or `$name(index)` - the parenthesized form is for array-style
// access like `$expect_out(0,string)`. The index is captured as raw text
// (no nested variable substitution inside it) and becomes part of the
// variable's name string, e.g. "expect_out(0,string)" - stored/looked-up as
// one flat key, not a real Tcl array. Atomic (`@`) so there's no implicit
// whitespace-skipping between `identifier` and the optional `array_index` -
// without that, attempting (and failing) to match a following `(` still
// consumes trailing whitespace into this rule's own span, e.g. turning `$i`
// followed by a space into the 3-character name "i " instead of "i".
variable = @{ "$" ~ identifier ~ array_index? }

array_index = @{ "(" ~ (!")" ~ ANY)* ~ ")" }

string = @{
    "\"" ~ string_inner ~ "\""
}

string_inner = @{
    (escape_seq | !("\"" | "\\") ~ ANY)*
}

escape_seq = @{
    "\\" ~ ("n" | "r" | "t" | "\\" | "\"" | "$")
}

brace_string = @{
    "{" ~ brace_string_inner ~ "}"
}

brace_string_inner = @{
    (!("{" | "}") ~ ANY | brace_string)*
}

list = {
    "{" ~ expression* ~ "}"
}

identifier = @{
    (ASCII_ALPHA | "_") ~ (ASCII_ALPHANUMERIC | "_")*
}

// A literal newline. Used (among other places) inside `newline*`/`+`
// repetitions for skipping blank lines - must stay strictly consuming, since
// a zero-width alternative here would make those repetitions "non-progressing"
// (pest rejects such grammars at compile time as a potential infinite loop).
newline = _{ "\n" }

// A statement's trailing terminator: a real newline, or (without consuming)
// the closing brace of the enclosing block / end of input - lets a block's
// last (or only) statement be written on the same line as its closing "}",
// e.g. `{incr i}` or a one-line expect action, without needing a newline
// that isn't actually there. Only ever used once per statement (never inside
// a repetition), so being zero-width-capable here is safe.
stmt_end = _{ "\n" | &"}" | &EOI }
